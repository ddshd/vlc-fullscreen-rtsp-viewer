[Unit]
Description=RTSP camera stream (mpv in cage kiosk)
After=network-online.target systemd-user-sessions.service getty@tty1.service
Wants=network-online.target
Conflicts=getty@tty1.service
# Never give up relaunching, even if it crash-loops for a while:
StartLimitIntervalSec=0

[Service]
Type=simple
User=dhrumil
PAMName=cage
SupplementaryGroups=video render input
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=XDG_SESSION_TYPE=wayland
# The camera URL (with credentials) lives here, NOT in git:
EnvironmentFile=/etc/camera-stream.env
ExecStart=/usr/bin/cage -- /usr/bin/mpv \
  --no-audio --rtsp-transport=udp --profile=low-latency --hwdec=no \
  --demuxer-lavf-o=fflags=nobuffer \
  --vo=gpu --fullscreen --no-osc --cursor-autohide=always \
  --no-input-default-bindings --really-quiet \
  --demuxer-lavf-o=timeout=5000000 \
  --input-ipc-server=/run/user/1000/mpv-camera.sock \
  --script=/usr/local/share/mpv-refresh/refresh-button.lua \
  "${CAMERA_URL}"
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

# Copy this to /etc/camera-stream.env on the device and put your real URL below.
# That file is read by camera-stream.service and is NEVER committed to git.
#
# If your username or password contains @ : / or #, percent-encode them
# (@ -> %40, : -> %3A, / -> %2F, # -> %23).

CAMERA_URL=rtsp://USER:PASS@192.168.1.2:554/h264Preview_01_sub
